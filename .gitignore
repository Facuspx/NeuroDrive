# Entornos virtuales (Evita subir megabytes de librerias instaladas)
.venv/
venv/
env/
ENV/

# Archivos temporales de ejecucion de Python
__pycache__/
*.py[cod]
*$py.class

# Configuracion local de Visual Studio Code
.vscode/

# Archivos de variables de entorno y contrasenias (Seguridad)
.env
secrets.json

# Archivos de datos o bases de datos locales (Opcional)
*.db
*.sqlite3

# Estado del nucleo entre sesiones (lo escribe main.py en cada ejecucion)
NeuroDrive_Core/estado_sesion.json
NeuroDrive_Core/estado_sesion.json.tmp

# Resultado de la ultima calibracion (lo escribe la vision; los valores
# vigentes se copian a config/config.yaml)
calibracion.json

# Registros de ensayos y listado del arbol de carpetas
*.log
tree.txt

# Paquetes de entrega descargados dentro del repo
*.zip

# Claves (cada una tiene su plantilla .ejemplo versionada)
config/ap.env
NeuroDrive_Firmware/components/red/credenciales.h

# Compilacion del firmware y del banco de pruebas
NeuroDrive_Firmware/build/
NeuroDrive_Firmware/banco/build/
NeuroDrive_Firmware/sdkconfig.old
NeuroDrive_Firmware/managed_components/
NeuroDrive_Firmware/dependencies.lock
