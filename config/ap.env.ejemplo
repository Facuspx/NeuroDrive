# Plantilla de la clave del punto de acceso. Este archivo SI se versiona.
#
# Copiarlo como config/ap.env y poner la clave real. config/ap.env esta
# excluido del control de versiones.
#
# Debe coincidir con PI_PASS en components/red/credenciales.h del firmware.
# WPA2 exige entre 8 y 63 caracteres.
WIFI_PASS="CLAVE_DEL_PUNTO_DE_ACCESO"
